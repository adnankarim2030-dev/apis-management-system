# Environment Configuration for APIS Backend
NODE_ENV=development
PORT=5000

# Database Configuration
# For PostgreSQL: DATABASE_URL="postgresql://postgres:postgres@localhost:5432/apis_db?schema=public"
# For Local Quickstart (SQLite): DATABASE_URL="file:./dev.db"
DATABASE_URL="file:./dev.db"

# JWT & Authentication
JWT_SECRET="apis_production_super_secret_jwt_key_2026_apis_management"
JWT_EXPIRES_IN="7d"
SESSION_SECRET="apis_super_secret_session_key_2026"

# URLs
CLIENT_URL="http://localhost:5173"
SERVER_URL="http://localhost:5000"

# Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=25

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
